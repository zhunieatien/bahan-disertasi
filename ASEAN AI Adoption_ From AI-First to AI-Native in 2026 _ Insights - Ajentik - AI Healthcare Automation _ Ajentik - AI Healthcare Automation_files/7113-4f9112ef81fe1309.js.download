"use strict";(self.webpackChunk_N_E=self.webpackChunk_N_E||[]).push([[7113],{67113:(e,t,i)=>{i.d(t,{s6:()=>a});let a={integration_count:null,integration_count_text:"We are building integrations with leading EHR and health-record systems. Specific integrations will be announced as they go live.",named_integrations:[],deployment_timeline_text:"Typical deployment timelines vary by scope. Contact us for an estimate based on your environment.",uptime_sla_text:"Production reliability targets are defined per customer contract.",sg_cluster_relationship_text:"Ajentik has completed the shortlisting stage and is currently in active discussions with all three major public healthcare clusters in Singapore.",sg_cluster_short_text:"In active discussions with Singapore's major public healthcare clusters (post-shortlisting).",hipaa_posture_text:'Ajentik is designed to support HIPAA-aligned workflows for healthcare customers. We implement administrative, physical, and technical safeguards consistent with the HIPAA Security Rule. We are not "HIPAA certified" — no such certification regime exists.',soc2_status_text:"SOC 2 Type II audit is in progress. We will publish a copy of the report under NDA once the observation window concludes.",iso27001_status_text:"ISO 27001 certification is currently in progress, with completion expected in 2026.",gdpr_status_text:'We process personal data in line with GDPR principles where applicable. GDPR has no third-party certification regime; "GDPR certified" claims are misleading.',pdpa_status_text:"We process personal data in line with Singapore PDPA where applicable. PDPA has no third-party certification regime; claims of PDPA certification are misleading.",encryption_text:"Data is encrypted in transit using TLS 1.3 and at rest using AES-256. Ajentik does not currently offer end-to-end encryption (E2EE).",legal_entity_name:"Ajentik AI Pte. Ltd.",canonical_domain:"ajentik.com",languages_list:["English"],recognition_claims:[{id:"harvard",title:"Harvard HSI Lab",detail:"Top 10 Ventures of 2025\nFeaturing Elderwise",source:"Harvard HSI Lab innovation directory and Elderwise year-in-review announcement: https://hsph.harvard.edu/research/health-systems-innovation-lab/work/innovation/ ; https://www.linkedin.com/posts/elderwise-care_elderwise-aiforgood-agetech-activity-7412068019662843904-Af7Z"},{id:"hkstp",title:"Incubated by HKSTP",detail:"Incubation Programme \xb7 2026",source:"HKSTP Incubation Programme acceptance letter dated 2026-03-02; company-owner verification recorded in the claims register."},{id:"enterpriseSg",title:"Enterprise Singapore",detail:"Startup SG Founder grant \xb7 2025",source:"Startup SG Founder grant award records and company-owner attestation in GitHub issue #682; programme: https://www.enterprisesg.gov.sg/grow-your-business/partner-with-singapore/innovation-and-startups/join-startup-sg"},{id:"raise",title:"raiSE Singapore",detail:"energiSE 2025 SG60 grant",source:"raiSE energiSE 2025 SG60 grant award and company-owner attestation in GitHub issue #682; programme: https://community.raise.sg/hubfs/raiSE%20Energise%20Grant%202025.pdf"}],products:[{slug:"elderwise-ai",display_name:"Elderwise AI",status:"ga",tagline:"Transforming geriatric care delivery",description:"Elderwise AI supports geriatric care coordination by connecting clinicians, patients, and families through shared care plans, check-ins, and secure messaging.",cta_link:"https://www.elderwise.ai",ios_app_link:"https://apps.apple.com/sg/app/elderwise/id6746748329",android_app_link:"https://play.google.com/store/apps/details?id=ai.elderwise.app"}],has_customer_references:!1}}}]);