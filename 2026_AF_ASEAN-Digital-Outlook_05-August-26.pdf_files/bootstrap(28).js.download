  padding: 10px 20px;
  border-radius: 20px;
  height: 40px;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;

  &:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }
`,xe=(0,g.Ay)(ke)`
  background-color: transparent;
  color: var(--spectrum-global-color-gray-800);
  border: 1px solid var(--spectrum-global-color-gray-400);

  &:hover:not(:disabled) {
    background-color: var(--spectrum-global-color-gray-100);
  }
