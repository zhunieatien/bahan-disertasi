  fieldset {
    display: flex;
    flex-direction: column;
    border: none;
    padding: 0;
    margin: 0;
    align-items: flex-start;
    text-align: left;
    width: 100%;
    max-width: 100%;
  }

  span[class*="jot-data-field-"] {
    display: block;
    width: 100%;
    max-width: 100%;
  }

  * {
    text-align: left;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  p, div, span {
    text-align: left;
    max-width: 100%;
  }
`,Hn=be.AH`
  .jot-checkbox-container,
  .jot-radio-container {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px;
    padding-left: 0;
    width: 100%;
    max-width: 100%;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .jot-checkbox-container *,
  .jot-radio-container * {
    font-size: inherit;
    line-height: inherit;
  }

  .jot-checkbox-container .jot-label-element,
  .jot-radio-container .jot-label-element {
    flex: 1;
    word-wrap: break-word;
    overflow-wrap: break-word;
    max-width: 100%;
  }
`,qn=be.AH`
  .jot-checkbox-container input[type="checkbox"] {
    appearance: none !important;
    -webkit-appearance: none !important;
    -moz-appearance: none !important;
    height: 20px;
    width: 20px;
    min-width: 20px;
    flex-shrink: 0;
    border-radius: 6px;
    border: 3px solid var(--spectrum-gray-800);
    position: relative;
    background-color: transparent;

    &:checked {
      background-color: var(--spectrum-gray-800);
      &::after {
        content: '✓';
        position: absolute;
        top: 55%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: white;
        font-size: 14px;
        font-weight: bold;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
      }
    }
  }
`,Kn=be.AH`
  .jot-radio-container input[type="radio"] {
    appearance: none !important;
    -webkit-appearance: none !important;
    -moz-appearance: none !important;
    height: 20px;
    width: 20px;
    min-width: 20px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 3px solid var(--spectrum-gray-800);
    position: relative;
    background-color: transparent;

    &:checked {
      background-color: var(--spectrum-gray-800);
      &::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background-color: var(--spectrum-gray-50);
      }
    }
  }
`,svgDataUri=i=>`data:image/svg+xml,${encodeURIComponent(i)}`,Un=svgDataUri("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><path d='M2 8 L6 12 L14 4' stroke='#05834E' stroke-width='2.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>"),Vn=svgDataUri("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><path d='M3 3 L13 13 M13 3 L3 13' stroke='#767676' stroke-width='2.5' fill='none' stroke-linecap='round'/></svg>"),Gn=be.AH`
  .correctAnswer {
    color: #05834E;
  }

  .incorrectAnswer {
    color: #D73220;
  }

  /* Checkbox - correct selected */
  .jot-checkbox-container.selectedAnswer.correctAnswer {
    color: #05834E;

    .jot-label-element,
    .jot-text {
      color: #05834E;
    }

    input[type="checkbox"] {
      border-color: #05834E;
      background-color: #05834E;

      &::after {
        content: '✓';
        color: white;
        font-size: 14px;
        font-weight: bold;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
      }
    }
  }

  /* Radio - correct selected */
  .jot-radio-container.selectedAnswer.correctAnswer {
    color: #05834E;

    .jot-label-element,
    .jot-text {
      color: #05834E;
    }

    input[type="radio"] {
      border-color: #05834E;
      background-color: #05834E;

      &::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background-color: var(--spectrum-gray-50);
      }
    }
  }

  /* Checkbox - incorrect selected */
  .jot-checkbox-container.selectedAnswer.incorrectAnswer {
    color: #D73220;

    .jot-label-element,
    .jot-text {
      color: #D73220;
      text-decoration: line-through;

      .inline-math-content {
        position: relative;
        display: inline-block;

        &::after {
          content: '';
          position: absolute;
          left: 0;
          right: 0;
          top: 50%;
          border-top: 0.08em solid currentColor;
          pointer-events: none;
        }
      }
    }

    input[type="checkbox"] {
      border-color: #D73220;
      background-color: #D73220;

      &::after {
        content: '✗';
        color: white;
        font-size: 14px;
        font-weight: bold;
        line-height: 1;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
      }
    }
  }

  /* Radio - incorrect selected */
  .jot-radio-container.selectedAnswer.incorrectAnswer {
    color: var(--spectrum-gray-300);

    .jot-label-element,
    .jot-text {
      color: var(--spectrum-gray-600);
      text-decoration: line-through;

      .inline-math-content {
        position: relative;
        display: inline-block;

        &::after {
          content: '';
          position: absolute;
          left: 0;
          right: 0;
          top: 50%;
          border-top: 0.08em solid currentColor;
          pointer-events: none;
        }
      }
    }

    input[type="radio"] {
      border-color: var(--spectrum-gray-600);
      background-color: var(--spectrum-gray-600);

      &::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background-color: var(--spectrum-gray-50);
      }
    }
  }

  /* Checkbox - correct not selected */
  .jot-checkbox-container.correctAnswer:not(.selectedAnswer) {
    color: #05834E;

    .jot-label-element,
    .jot-text {
      color: #05834E;
    }

    input[type="checkbox"] {
      border-color: #05834E;
      background-color: #05834E;

      &::after {
        content: '✓';
        color: white;
        font-size: 14px;
        font-weight: bold;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
      }
    }
  }

  /* Radio - correct not selected */
  .jot-radio-container.correctAnswer:not(.selectedAnswer) {
    color: #05834E;

    .jot-label-element,
    .jot-text {
      color: #05834E;
    }

    input[type="radio"] {
      border-color: #05834E;
      border-width: 3px;
    }
  }

  /* Correct selected — green tick */
  .jot-radio-container.selectedAnswer.correctAnswer {
    &::before {
      content: '';
      display: inline-block;
      width: 14px;
      height: 14px;
      flex-shrink: 0;
      margin-right: 8px;
      background-image: url("${Un}");
      background-repeat: no-repeat;
      background-size: contain;
      background-position: center;
    }
  }

  /* Incorrect selected — grey cross */
  .jot-radio-container.selectedAnswer.incorrectAnswer {
    &::before {
      content: '';
      display: inline-block;
      width: 14px;
      height: 14px;
      flex-shrink: 0;
      margin-right: 8px;
      background-image: url("${Vn}");
      background-repeat: no-repeat;
      background-size: contain;
      background-position: center;
    }
  }

  /* Correct not selected — green tick */
  .jot-radio-container.correctAnswer:not(.selectedAnswer) {
    &::before {
      content: '';
      display: inline-block;
      width: 14px;
      height: 14px;
      flex-shrink: 0;
      margin-right: 8px;
      background-image: url("${Un}");
      background-repeat: no-repeat;
      background-size: contain;
      background-position: center;
    }
  }
`,Wn=be.Ay.div`
  height: 100%;
  width: 100%;
