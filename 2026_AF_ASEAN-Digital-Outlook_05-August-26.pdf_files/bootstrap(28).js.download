  width: 100%;

  .jot-editable-region > :first-child {
    margin-top: 0 !important;
  }

  /* When the trailing empty paragraph is hidden, the visually last element is :nth-last-child(2).
     Otherwise (last paragraph has content) it is :last-child. */
  .jot-last-hidden .jot-editable-region > :nth-last-child(2),
  .jot-editor-read:not(.jot-last-hidden) .jot-editable-region > :last-child {
    margin-bottom: 0 !important;
  }

  /* StyledRegion has overflow-y: auto which can show a 1px scrollbar from
    sub-pixel line-height differences. ExpandableCardWrapper already clips
    overflow so the inner scroll is not needed. */
  .note-region {
    overflow-y: hidden;
  }
