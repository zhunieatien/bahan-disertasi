    box-sizing: border-box;
    border-radius: 4px;
    font-style: normal;
    font-size: 10px;
    margin-right: 4px;
    margin-left: 4px;
    padding: 0px 5px;
    display: inline-flex;
    height: 16px;
    min-width: 16px;
    justify-content: center;
    align-items: center;
    gap: 3px;
    vertical-align: middle;
    user-select: none;

    /* Local defaults for the semantic pill classes used by attribution renderers. */
    &.jot-pill-document-available,
    &.jot-pill-web-available {
      --jot-pill-bg: var(--spectrum-indigo-200, #E0E2FF);
      --jot-pill-fg: var(--spectrum-indigo-1400, #141648);
    }

    &.jot-pill-document-removed,
    &.jot-pill-document-modified,
    &.jot-pill-document-no-access,
    &.jot-pill-web-removed,
    &.jot-pill-web-modified,
    &.jot-pill-web-no-access {
      --jot-pill-bg: var(--spectrum-orange-200, #FFECCF);
      --jot-pill-fg: var(--spectrum-gray-800, #222);
    }

    .marker-globe {
      display: inline-flex;
      align-items: center;
      flex-shrink: 0;
      svg { width: 12px; height: 12px; }
    }

    .marker-text {
      cursor: default;
      white-space: nowrap;
    }

    .marker-text-external {
      display: inline-flex;
      align-items: center;
      line-height: 1;
      cursor: default;
      white-space: nowrap;
