  display: flex;
  flex-direction: column;
  width: 100%;
  position: relative;
  padding: 4px;
  box-sizing: border-box;
  ${i=>{let{$colorScheme:c}=i;return"light"===c?ca:ua}}

  /* Override JotNoteEditor's .editable-region (&& doubles specificity so parent wins over child) */
  && .editable-region {
    max-width: 100%;
  }

  /* Disable scroll-anchoring so layout changes when a block's toolbar
    flips between embedded/floating don't shift the sticky sentinel and
    cause a flip-flop loop at the threshold. */
  overflow-anchor: none;

  /* Overview portals the toolbar into a block-level ToolbarHostSlot, so
    the editor's in-place overlay wrapper is empty. Drop its 82px
    reservation and un-establish the scroll container so sticky works. */
  && .content-container {
    padding-top: 0;
    overflow-y: visible;
  }
