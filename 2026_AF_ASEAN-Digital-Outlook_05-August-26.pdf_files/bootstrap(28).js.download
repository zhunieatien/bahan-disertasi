  /* Cell backgrounds */
  th {
    background: var(--spectrum-gray-200, #E9E9E9);
  }

  td {
    background: transparent;
  }

  /* Add top border to first row cells */
  thead tr:first-child th,
  thead tr:first-child td,
  tbody:first-child tr:first-child td,
  tbody:first-child tr:first-child th {
    border-top: ${v};
  }

  /* Add left border to first column cells */
  td:first-child,
  th:first-child {
    border-left: ${v};
  }

  /* Outer corner rounding. Each rule targets one logical corner via the
     per-corner border-*-radius property; the four rules together turn the
     table into a rounded rectangle and work regardless of which sections
     exist (thead/tbody/tfoot, in any combination), whether the corner cell
     is a td or a th (header column makes the first column th inside
     tbody/tfoot), the number of rows in each section, or paste-induced
     mutations. The universal child selector ">:first-child" / ">:last-child"
     matches both td and th so the header-column case needs no extra rules. */

  /* Top corners — topmost section's first row, outermost cells. */
  thead:first-child tr:first-child > :first-child,
  tbody:first-child tr:first-child > :first-child {
    border-top-left-radius: 8px;
  }
  thead:first-child tr:first-child > :last-child,
  tbody:first-child tr:first-child > :last-child {
    border-top-right-radius: 8px;
  }

  /* Bottom corners — bottommost section's last row, outermost cells.
     thead:last-child handles tables that have only a thead (e.g. a fresh
     insertTable(1, n)) so the bottom corners still round off the header. */
  tbody:last-child tr:last-child > :first-child,
  tfoot:last-child tr:last-child > :first-child,
  thead:last-child tr:last-child > :first-child {
    border-bottom-left-radius: 8px;
  }
  tbody:last-child tr:last-child > :last-child,
  tfoot:last-child tr:last-child > :last-child,
  thead:last-child tr:last-child > :last-child {
    border-bottom-right-radius: 8px;
  }
