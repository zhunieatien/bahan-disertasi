    outline: 2px solid var(--spectrum-focus-ring-color, var(--spectrum-blue-800));
    z-index: 1;
  }

  /* Dashed divider line rendered as a pseudo-element so it's part of the hit area */
  &::before {
    background-image: linear-gradient(to right, var(--spectrum-gray-200) 50%, transparent 60%);
    background-repeat: repeat-x;
    background-size: 12px 2px;
    content: "";
    height: 2px;
    left: 0;
