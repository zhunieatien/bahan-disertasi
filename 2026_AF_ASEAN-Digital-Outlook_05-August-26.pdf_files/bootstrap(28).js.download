  height: var(--spectrum-global-dimension-static-size-300, 24px) !important;
  padding: 0 !important;
  border: none !important;
  border-radius: 7px !important;
  background: transparent !important;
  transition: background 0.15s ease-in-out, box-shadow 0.15s ease-in-out !important;

  &:hover {
    background: var(--spectrum-global-color-gray-50, #FFFFFF) !important;
    box-shadow: 0 var(--spectrum-global-dimension-static-size-10, 1px) 3px rgba(0, 0, 0, 0.15) !important;
  }

  .spectrum--dark &:hover {
    background: var(--s2-gray-400, var(--spectrum-global-color-gray-400, #C6C6C6)) !important;
  }

  &:focus-visible {
    outline: var(--spectrum-global-dimension-static-size-25, 2px) solid var(--spectrum-alias-focus-color) !important;
    outline-offset: var(--spectrum-global-dimension-static-size-25, 2px) !important;
  }

  &::after,
  &::before {
    display: none !important;
  }

  svg,
  svg path,
  svg g,
  svg * {
    fill: var(--spectrum-global-color-gray-800, #2C2C2C) !important;
  }

  &:disabled,
  &[aria-disabled="true"] {
    opacity: 0.4 !important;
    cursor: default !important;
    pointer-events: none !important;

    &:hover {
      background: transparent !important;
      box-shadow: none !important;
    }
  }

  @media (forced-colors: active) {
    forced-color-adjust: none;
    background: #ffffff !important;
