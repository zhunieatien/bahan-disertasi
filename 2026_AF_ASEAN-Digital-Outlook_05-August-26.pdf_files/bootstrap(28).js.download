  /* :where() keeps these defaults low-specificity so client styles can override the stable classes. */
  :where(.jot-button-element.jot-button--mixed-content) > :where(.jot-button-text, .jot-button-visual) {
    vertical-align: middle;
  }

  :where(.jot-button-element.jot-button--mixed-content) > :where(
    .jot-button-visual + .jot-button-text,
    .jot-button-text + .jot-button-visual
  ) {
    margin-inline-start: 6px;
  }

  /* Avoid inline-image baseline descender space inside Spectrum's flex layout. */
  :where(.jot-button-element.jot-button--mixed-content) > :where(.jot-button-image) {
    display: inline-flex;
    align-items: center;
  }
