`,N=(0,S.Ay)(D)`
    display: block;
    cursor: pointer;
    color: var(--spectrum-indigo-1400, #1F0062) !important;
    font-size: var(--spectrum-global-dimension-font-size-200, 1rem) !important;
    font-style: normal !important;
    font-weight: 500 !important;
    line-height: 1.125rem !important;
    letter-spacing: 0 !important;
    height: fit-content !important;
    width: fit-content !important;
    margin: var(--spectrum-global-dimension-size-150) 0 !important;
    background: var(--spectrum-indigo-200, #EBEEFF) !important;

    &:not([data-genpres]) svg,
    &:not([data-genpres]) svg *,
    &:not([data-genpres]) svg g,
    &:not([data-genpres]) svg g * {
        fill: var(--spectrum-global-color-gray-800) !important;
    }

    /* Hide the zero-width spacer span immediately following this button */
    &[data-next-step-button] + span[data-slate-node="text"] {
        display: none !important;
    }

    /* GenPres suggestion button */
    &[data-genpres] svg:last-of-type {
        width: 12px;
    }

    &[data-genpres] {
        --iconFill: var(--spectrum-gray-800);
        border: 2px solid transparent !important;
        padding: 6px 12px !important;
        background:
            linear-gradient(var(--spectrum-indigo-200, #EBEEFF), var(--spectrum-indigo-200, #EBEEFF)) padding-box,
            linear-gradient(90deg, #D7373F 0%, #C9369A 50%, #7B70D3 100%) border-box !important;

        &:hover, &:focus-visible {
            background:
                linear-gradient(var(--spectrum-gray-300, #D9D9D9), var(--spectrum-gray-300, #D9D9D9)) padding-box,
                linear-gradient(90deg, #D7373F 0%, #C9369A 50%, #7B70D3 100%) border-box !important;
        }
    }

    /* GenPres suggestion button - dark theme */
    &[data-genpres][data-color-scheme="dark"] {
        background:
            linear-gradient(var(--spectrum-indigo-200, #EBEEFF), var(--spectrum-indigo-200, #EBEEFF)) padding-box,
            linear-gradient(90deg, #D7373F 0%, #C9369A 50%, #7B70D3 100%) border-box !important;
    }

    &[data-genpres][data-color-scheme="dark"]:hover,
    &[data-genpres][data-color-scheme="dark"]:focus-visible {
        background:
            linear-gradient(var(--spectrum-gray-300, #D9D9D9), var(--spectrum-gray-300, #D9D9D9)) padding-box,
            linear-gradient(90deg, #D7373F 0%, #C9369A 50%, #7B70D3 100%) border-box !important;
    }
