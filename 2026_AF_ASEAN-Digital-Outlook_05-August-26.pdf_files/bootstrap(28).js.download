  .jot-disclosure-title-element button {
    display: flex !important;
    align-items: center !important;
  }

  /* Move React Spectrum's chevron (first SVG) to the end */
  .jot-disclosure-title-element button > svg:first-of-type {
    order: 1 !important;
    margin-left: 8px !important;
    margin-right: 0 !important;
  }

  /* Add spacing after icons from note-doc */
  .jot-disclosure-title-element button > svg:not(:first-of-type),
  .jot-disclosure-title-element button .jot-icon-element {
    margin-right: 8px !important;
  }

  /* Chevron rotation: down when collapsed, up when expanded */
  .jot-disclosure-title-element button[aria-expanded="false"] > svg:first-of-type {
    transform: rotate(90deg) !important;
  }

  .jot-disclosure-title-element button[aria-expanded="true"] > svg:first-of-type {
    transform: rotate(-90deg) !important;
  }
