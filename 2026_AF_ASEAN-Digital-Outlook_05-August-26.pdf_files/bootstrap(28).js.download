  ${ze.nO.name} {
    display: flex;
    padding: 4px;
    flex-direction: column;
    align-items: stretch;
    border-radius: 8px;
    background-color: var(--spectrum-global-color-gray-50, #FFF);
    border: 1px solid var(--spectrum-global-color-gray-300);
    box-shadow: 0px 1px 8px 0px rgba(0, 0, 0, 0.1);
    box-sizing: border-box;
    list-style: none;
    min-width: 200px;
    user-select: none;
  }

  ${ze.nO.name}[data-submenu="true"] {
    margin-left: 8px !important;
    padding: 4px;
  }

  ${ze.nO.name}:focus,
  ${ze.uA.name}:focus {
    outline: none;
  }

  ${ze.nO.stateOpening} {
    animation: ${tt} 0.15s ease-out;
  }

  ${ze.nO.stateClosing} {
    animation: ${rt} 0.2s ease-out forwards;
  }

  ${ze.uA.name} {
    width: 100%;
    padding: 10px 36px 10px 12px;
    border-radius: 6px;
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    box-sizing: border-box;
    cursor: pointer;
    font-size: 15px;
    font-weight: 400;
    color: var(--spectrum-global-color-gray-900);
    white-space: nowrap;
    line-height: 1.4;
    background: transparent;
    transition: background-color 0.13s ease;

    svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      opacity: 0.85;
    }

    span {
      flex: 1;
    }
  }

  ${ze.uA.hover} {
    background-color: var(--spectrum-global-color-gray-200);
  }

  ${ze.uA.submenu} > ${ze.uA.name} {
    position: relative;

    &::after {
      content: '›';
      position: absolute;
      right: 12px;
      font-size: 20px;
      font-weight: 300;
      color: var(--spectrum-global-color-gray-700);
      opacity: 0.7;
    }
  }
