  ${i=>{let{$isDark:c}=i;return c?Y.uG:Y.i_}}
  ${Y.xi}
  font-family: ${i=>{let{fontFamily:c}=i;return c}};
  height: 100%;
  width: ${i=>{let{$fitContentWidth:c}=i;return c?"fit-content":"100%"}};
  position: relative;
  display: flex;
  flex-direction: column;

  ${b.iH}

  position: relative;
  white-space: var(--jot-white-space, pre-wrap);
  overflow-wrap: break-word;

  /* Component Styles */
  .jot-h1-element {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--spectrum-gray-800);
  }
  .jot-h2-element {
    font-size: 1rem;
    font-weight: 800;
    color: var(--spectrum-gray-800);
  }
  .jot-h3-element {
    font-size: 1rem;
    font-weight: 700;
    color: var(--spectrum-gray-800);
  }
  .jot-h4-element {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--spectrum-gray-800);
  }
  .jot-h5-element {
    font-size: 1rem;
    font-weight: 700;
    color: var(--spectrum-gray-800);
  }
  .jot-h6-element {
    font-size: 1rem;
    font-weight: 700;
    color: var(--spectrum-gray-800);
  }

  .jot-blockquote-element {
    border-left: 2px solid lightgray;
    margin-left: 0;
    padding-left: 20px;
  }

  /* Table */
  .jot-table-element {
    ${v.th}
  }

  .jot-hrule-element {
    border: 1px solid var(--spectrum-gray-200);
    border-radius: 2px;
    margin: 16px 0;
  }

  .jot-data-field-checkbox {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .jot-data-field-radio {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* Data Field Wrapper and Label Positioning */
  .jot-data-field-checkbox,
  .jot-data-field-radio,
  .jot-data-field-text,
  .jot-data-field-number,
  .jot-data-field-date {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* Label positioning within data fields */
  .jot-label-element {
    white-space: nowrap;
  }

  ul, ol, li, td {
    p {
      margin: 0; /* Remove default margin for paragraphs inside list items */
    }
  }

  .jot-podcast-dialog-element + .jot-podcast-dialog-element {
    margin-top: 24px;
  }

  .jot-div-element {
    .jot-button-wrapper + .jot-button-wrapper {
      margin-left: 16px;
    }
  }

  // Move this to a client component if possible
  .jot-study-package-tags {
    align-items: center;
    gap: 8px;
    justify-content: center;
  }

  .jot-study-package-tag {
    align-items: center;
    border-radius: 7px;
    display: flex;
    font-size: 12px;
    gap: 4px;
    line-height: 16px;
    padding: 4px 9px;
  }

  .jot-study-package-tag:has(> .jot-icon-element) {
    padding-left: 4px;
  }

  .jot-study-package-sessions {
    background-color: #F8F8F8;
    border-radius: 8px;

    .jot-paragraph-element {
      margin: 0;
    }

    >.jot-column-layout-element {
      border-bottom: 1px solid rgba(113, 113, 113, 0.1);
      gap: 12px;
      padding: 8px 12px;

      .jot-study-package-tag {
        cursor: pointer;
        padding: 4px;
        transition: filter 0.15s ease, transform 0.15s ease;

        &:hover {
          filter: brightness(0.9);
          transform: scale(1.08);
        }
      }

      > *:nth-child(2) {
        flex-grow: 1;
      }

      > *:last-child {
        align-items: flex-start;
        align-self: flex-end;
        gap: 8px;
      }
    }
  }

  .jot-study-package-navigation {
    align-items: center;
    justify-content: space-between;
  }

  /* Overview Page Layout */
  .jot-block-layout-element {
    display: flex;
    flex-direction: column;
    width: 100%;
    align-items: center;
  }

  // provide a default icon fill color for the icons in the jot-viewer
  --iconFill: var(--spectrum-global-color-gray-800);
