`,ri=v.Ay.div`
    box-shadow: 0px 2px 16px 0px var(--spectrum-global-color-gray-400);
    border-radius: 24px 24px 0px 0px;
    padding: 6px 20px 48px 20px;
    user-select: none;

    font-size: 14px;
    font-weight: normal;

    button {
      &[class*="is-selected"] {
        background-color: var(--spectrum-global-color-gray-300) !important;

        span {
          color: var(--spectrum-global-color-gray-800);
        }
      }
    }

    // Remove the default focus ring from bottom menu
    ${i=>{let{$showFocusRing:c}=i;return!c&&"\n        button {\n          &::after {\n            box-shadow: none !important;\n          }\n        }\n    "}}
`,ni=v.Ay.div`
    display: flex;
    flex-direction: row;
    align-items: center;
    border-radius: 9px;
    border: 1px solid var(--spectrum-global-color-gray-300);
    background: var(--spectrum-global-color-gray-50);
    height: 44px;

    > button {
        flex: 1;
        height: 100%;
        min-width: 44px;
        background: transparent;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        transition: background-color 0.2s ease;
        -webkit-tap-highlight-color: transparent;

        &:not(:last-child)::before {
            content: '';
            position: absolute;
            left: 100%;
            top: 0px;
            bottom: 0;
            width: 1px;
            height: 100%;
            background: var(--spectrum-global-color-gray-300);
        }

        &.middle-mark-icon {
            border-radius: 0;
        }

        &:active {
            background: var(--spectrum-global-color-gray-200);
        }

        svg {
            width: 20px;
            height: 20px;
            fill: var(--spectrum-global-color-gray-700);
        }

        &:first-child {
            border-radius: 9px 0 0 9px;
        }

        &:last-child {
            border-radius: 0 9px 9px 0;
