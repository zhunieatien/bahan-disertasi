  flex: 1;
  overflow-y: auto;
  overflow-x: auto;

  ${Q.iH}

.jot-editable-region,
  div[role="textbox"] {
    overflow: visible;
  }

  div[role="textbox"]:focus-visible {
    outline: none;
  }

  h1.jot-h1-element {
    ${Q.oP}
  }

  h2.jot-h2-element {
    ${Q.pI}
  }

  h3.jot-h3-element {
    ${Q.yN}
  }

  h4.jot-h4-element {
    ${Q.dv}
  }

  h5.jot-h5-element, h6.jot-h6-element {
    ${Q.Af}
  }

  ul, ol, li, td {
    p {
      margin: 0; /* Remove default margin for paragraphs inside list items */
    }
  }

  .jot-editable-region ul li.jot-list-item-marker-inside > *:first-child,
  .jot-editable-region ol li.jot-list-item-marker-inside > *:first-child {
    display: inline ; /* Center/right aligned list items: keep bullet/number and content on one line */
  }

  hr {
    border: 1px solid var(--spectrum-gray-200);
    border-radius: 2px;
    margin: 16px 0;
  }

  &.jot-android-view hr,
  &.jot-ios-view hr {
    border: 0.5px solid var(--spectrum-gray-300);
  }

  ${i=>{let{$isMovingX:c}=i;return`\n      overflow-y: ${c?"hidden":"auto"};\n      overflow-x: ${c?"auto":"hidden"};\n    `}}

  /* --- Japanese emphasis handling --- */
  /* Allow fake italics (style synthesis) for JP glyph runs only */
  .jot-editable-region :lang(ja) em,
  .jot-editable-region :lang(ja) i,
  .jot-editable-region :lang(ja) .italic {
    font-synthesis-style: auto;  /* Enable style synthesis for CJK fonts */
  }

  .jot-blockquote-element {
    border-left: 2px solid lightgray;
    margin-left: 0;
    padding-left: 20px;
  }
