      outline: var(--spectrum-global-dimension-static-size-25, 2px) solid var(--spectrum-alias-focus-color) !important;
      outline-offset: var(--spectrum-global-dimension-static-size-25, 2px) !important;
    }

    &::after,
    &::before {
      display: none !important;
    }

    svg,
    svg path,
    svg g,
    svg * {
      fill: var(--spectrum-global-color-gray-800, #2C2C2C) !important;
    }

    &[disabled] {
      cursor: default;

      svg,
      svg path,
      svg g,
      svg * {
        fill: var(--spectrum-global-color-gray-400, #B3B3B3) !important;
      }

      &:hover {
        background: transparent !important;
        box-shadow: none !important;
      }
    }

    @media (forced-colors: active) {
      forced-color-adjust: none;
      background: #ffffff !important;
      border: 1px solid #000000 !important;
      box-shadow: none !important;

      svg,
      svg path,
      svg g,
      svg * {
        forced-color-adjust: none;
        fill: #000000 !important;
      }

      &[disabled] svg,
      &[disabled] svg path,
      &[disabled] svg g,
      &[disabled] svg * {
        fill: #666666 !important;
      }

      .spectrum--dark & {
        background: #000000 !important;
        border-color: #ffffff !important;

        svg,
        svg path,
        svg g,
        svg * {
          fill: #ffffff !important;
        }
      }

      @media (prefers-color-scheme: dark) {
        background: #000000 !important;
        border-color: #ffffff !important;

        svg,
        svg path,
        svg g,
        svg * {
          fill: #ffffff !important;
        }
      }
    }
  }
