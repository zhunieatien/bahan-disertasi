  ${ar.th}

  /* Suppress the browser's cross-cell text selection while a rectangular cell
     range is active. Driven by a transient prop so the rule lives with the rest
     of the table styling — avoids mutating tableEl.style imperatively from the
     drag hook, which a future React style-prop change could clobber. */
  ${i=>{let{$isRangeSelected:c}=i;return c&&Re.AH`
    user-select: none;
  `}}

  /* Editor-only: square individual outer corners while a selection overlay
     sits on them, so the overlay's square edge aligns with the cell instead
     of leaving a rounded sliver visible underneath. Selectors mirror the
     outer-corner rules in sharedTableCSS exactly, so they hit the same cells
     across every section/cell-type permutation.
     BR is never squared — both column and row overlays draw a rounded BR
     when they cover the corner, which already aligns with the cell's BR. */
  &[data-square-tl="true"] {
    thead:first-child tr:first-child > :first-child,
    tbody:first-child tr:first-child > :first-child {
      border-top-left-radius: 0 !important;
    }
  }
  &[data-square-tr="true"] {
    thead:first-child tr:first-child > :last-child,
    tbody:first-child tr:first-child > :last-child {
      border-top-right-radius: 0 !important;
    }
  }
  &[data-square-bl="true"] {
    tbody:last-child tr:last-child > :first-child,
    tfoot:last-child tr:last-child > :first-child,
    thead:last-child tr:last-child > :first-child {
      border-bottom-left-radius: 0 !important;
