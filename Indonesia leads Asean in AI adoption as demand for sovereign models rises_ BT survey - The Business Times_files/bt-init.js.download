googletag.cmd.push((()=>{googletag.setConfig({disableInitialLoad:true})}));console.log("INIT LOADED");const mediaQueries={mobile:window.matchMedia("(max-width: 739px)"),tablet:window.matchMedia("(min-width: 740px) and (max-width: 1023px)")};const getDeviceCategory=()=>{if(mediaQueries.mobile.matches)return"mobile";if(mediaQueries.tablet.matches)return"tablet";return"desktop"};window.canRunAds=true;window.deviceForBids=getDeviceCategory();let prestitialEnabled=true;let postitialEnabled=true;let topOverlayImpressionsServed=0;let topOverlayImpressions=4;let overlayValidity=120;if(window.deviceForBids==="mobile"){overlayValidity=60}let catfishEnabled=true;let anchorEnabled=true;let xxlEnabled=true;let xxlMax=5;let xxlValidity=30;let catfishValidity=120;let renderCatfishOnce=false;window.taboola_enable=1;window.shouldRenderPostitial=false;window.shouldRenderPrestitial=false;window.shouldRenderCatfish=false;window.xxlStatus=false;window.renderCatfishStatus=false;window.pgUrlParams=new URLSearchParams(window.location.search);const kvInitObj={};if(isInAppView()==true){kvInitObj["webview"]=["Y"]}else{kvInitObj["webview"]=["N"]}googletag.cmd.push((()=>{googletag.setConfig({targeting:kvInitObj})}));if(sessionStorage.getItem("eshop-checkout-ongoing")==="true"){prestitialEnabled=false;postitialEnabled=false;catfishEnabled=false;anchorEnabled=false}const dfpPreviewIds=window.pgUrlParams.get("dfp_preview");if(dfpPreviewIds!==null){const valTestAdid=window.pgUrlParams.get("test_adid");const valTestPlid=window.pgUrlParams.get("test_plid");googletag.cmd.push((()=>{const dfpTargeting={dfp_preview:dfpPreviewIds};if(valTestAdid!==null)dfpTargeting.test_adid=valTestAdid;if(valTestPlid!==null)dfpTargeting.test_plid=valTestPlid;googletag.setConfig({targeting:dfpTargeting})}))}topOverlayImpressionsServed=Number.parseInt(getLocS("topOverlayImpressionsServed")??"0",10);if(Number.isNaN(topOverlayImpressionsServed)){topOverlayImpressionsServed=0}const topOverlayDisplayed=getLocS("topoverlayDisplayed")==="yes";const canRunAdsCheck=window.canRunAds===true;const isMobile=window.deviceForBids==="mobile";const isPreview=dfpPreviewIds!=null;function incrementTopOverlayImpressions(){topOverlayImpressionsServed+=1;if(topOverlayImpressionsServed>=topOverlayImpressions){topOverlayImpressionsServed=0;setLocS("topoverlayDisplayed","yes",overlayValidity)}setLocS("topOverlayImpressionsServed",String(topOverlayImpressionsServed),overlayValidity)}if(typeof window.canRunAds!=="undefined"){const postitialCheck=canRunAdsCheck&&isMobile&&postitialEnabled&&topOverlayImpressionsServed<topOverlayImpressions&&!topOverlayDisplayed||isPreview&&isMobile;const prestitialCheck=canRunAdsCheck&&!isMobile&&prestitialEnabled&&topOverlayImpressionsServed<topOverlayImpressions&&!topOverlayDisplayed||isPreview&&!isMobile;if(postitialCheck){window.shouldRenderPostitial=true}else if(prestitialCheck){window.shouldRenderPrestitial=true;incrementTopOverlayImpressions()}}googletag.cmd.push((()=>{googletag.pubads().addEventListener("slotRenderEnded",(event=>{const slotId=event.slot.getSlotElementId();if(slotId==="postitial_holder"){incrementTopOverlayImpressions()}}))}));let xxlCounter=parseInt(getLocS("xxlCounter")??"0",10);if(Number.isNaN(xxlCounter))xxlCounter=0;let xxlDefAction=0;if(xxlEnabled){if(window.deviceForBids==="mobile"&&catfishEnabled){if(xxlCounter<=1){console.log("xxl: xxl or catfish");let ratioXXL=.5;if(xxlCounter===0){ratioXXL=.6}const ratioRandom=Math.random();if(ratioRandom<ratioXXL){xxlDefAction=1}else{console.log("xxl: catfish")}}else{xxlDefAction=2}}else{xxlDefAction=3}}if(xxlDefAction>0){if(xxlCounter<xxlMax){xxlCounter+=1;setLocS("xxlCounter",xxlCounter,xxlValidity);window.xxlStatus=true;catfishEnabled=false;anchorEnabled=false;if(xxlDefAction===1){console.log("xxl: xxl")}else if(xxlDefAction===2){console.log("xxl: xxl only")}else if(xxlDefAction===3){console.log("xxl: desktop mode")}}}if(window.deviceForBids==="mobile"&&catfishEnabled){window.shouldRenderCatfish=true}function renderCatfish(adunitname){console.log("catfish => "+adunitname);if(renderCatfishOnce)return;if(typeof adunitname!=="string")return;renderCatfishOnce=true;if(adunitname.startsWith("/5908/bt/catfish/")){googletag.cmd.push((()=>{window.gadSlots||={};window.gadSlots.catfish=googletag.defineSlot(adunitname,[1,1],"dfp-ad-catfish").addService(googletag.pubads()).setConfig({targeting:{pos:["catfish"],weight:["1"]}});window.renderCatfishStatus=true}))}}function isInAppView(){const ua=navigator.userAgent.toLowerCase();if(ua.includes("com.sph.btiphone")){return true}if(ua.includes("com.ps.bt")){return true}const appMarkers=["fban","fbav","instagram","line/","micromessenger","twitter","pinterest"];if(appMarkers.some((marker=>ua.includes(marker)))){return true}if(ua.includes("android")&&ua.includes("wv")){return true}const isIOS=/iphone|ipad|ipod/.test(ua);const isWebKit=ua.includes("applewebkit");const isSafari=ua.includes("safari");if(isIOS&&isWebKit&&!isSafari){return true}return false}function setLocS(key,value,mins){const item={value:value,expiry:Date.now()+mins*60*1e3};try{localStorage.setItem(key,JSON.stringify(item))}catch{}}function getLocS(key){const itemStr=localStorage.getItem(key);if(!itemStr)return null;let item;try{item=JSON.parse(itemStr)}catch{localStorage.removeItem(key);return null}if(!item||typeof item.expiry!=="number"){localStorage.removeItem(key);return null}if(Date.now()>item.expiry){localStorage.removeItem(key);return null}return item.value}function getlse(key){const itemStr=localStorage.getItem(key);if(!itemStr)return null;let item;try{item=JSON.parse(itemStr)}catch{return null}if(!Number.isFinite(item?.expiry))return"Invalid timestamp";return new Date(item.expiry).toLocaleString("en-US",{year:"numeric",month:"long",day:"numeric",hour:"2-digit",hour12:false,minute:"2-digit",second:"2-digit",timeZoneName:"short"})}